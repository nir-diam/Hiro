# api.hiro.co.il — backend API (Express on :4000).
# Sonar scan can take 10–60s; default proxy timeouts (60s) cause 504/524 responses
# without CORS headers, which browsers report as a CORS error on POST.
#
# Include inside the api.hiro.co.il server block. Adjust upstream/port as needed.

upstream hiro_api {
    server 127.0.0.1:4000;
}

server {
    listen 443 ssl http2;
    server_name api.hiro.co.il;

    client_max_body_size 50m;

    location / {
        proxy_pass http://hiro_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long-running endpoints (sonar-scan, bulk imports, AI parsing)
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}
